   "y": 40,
   "w": 16,
   "h": 72,
   "vertical": true,
   "src": "car.throttle",
   "color": "@green",
   "track": "#323640"
  },
  {
   "name": "Brake bar",
   "type": "bar",
   "x": 46,
   "y": 40,
   "w": 16,
   "h": 72,
   "vertical": true,

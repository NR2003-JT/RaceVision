   "color": "@grey",
   "text": "THR"
  },
  {
   "name": "Brake label",
   "type": "text",
   "x": 38,
   "y": 114,
   "w": 32,
   "size": 11,
   "align": "center",
   "color": "@grey",
   "text": "BRK"
  },
  {
   "name": "Speed",

{
 "title": "RaceVision Telemetry Strip",
 "panel": "custom",
 "w": 440,
 "h": 136,
 "when": "onboard",
 "accent": "car",
 "elements": [
  {
   "name": "Panel",
   "type": "rect",
   "x": 0,
   "y": 0,
   "w": 440,
   "h": 136,
   "radius": 10,
   "fill": "@bg"
  },
  {
   "name": "Driver",

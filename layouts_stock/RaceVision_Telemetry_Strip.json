   "x": 84,
   "y": 32,
   "w": 150,
   "size": 58,
   "align": "right",
   "color": "@white",
   "text": "{car.speed_mph:0}"
  },
  {
   "name": "MPH",
   "type": "text",
   "x": 240,
   "y": 62,
   "w": 50,
   "size": 16,
   "color": "@grey",
   "text": "MPH"
  },
  {
   "name": "Gear",

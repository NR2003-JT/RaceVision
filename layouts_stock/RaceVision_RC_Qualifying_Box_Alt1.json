{
    "title":  "RaceVision RC Qualifying Box, dash style",
    "panel":  "custom",
    "w":  460,
    "h":  116,
    "when":  "rc.qual",
    "accent":  "car",
    "elements":  [
                     {
                         "name":  "Panel",
                         "type":  "rect",
                         "x":  0,
                         "y":  0,
                         "w":  460,
                         "h":  116,
                         "fill":  "#0b0d12ee",
                         "radius":  6
                     },
                     {
                         "name":  "Place plate",
                         "type":  "rect",
                         "x":  0,
                         "y":  0,
                         "w":  110,
                         "h":  116,
                         "fill":  "@gold",
                         "slant":  14
                     },
                     {
                         "name":  "Place label",
                         "type":  "text",
                         "x":  8,
                         "y":  8,
                         "w":  90,
                         "size":  13,
                         "text":  "QUALIFYING",
                         "color":  "#14161c",
                         "font":  "Saira Condensed",
                         "align":  "center",
                         "bold":  true
                     },
                     {
                         "name":  "Place",
                         "type":  "text",
                         "x":  8,
                         "y":  22,
                         "w":  90,
                         "size":  52,
                         "text":  "{rc.qual.car_pos}",
                         "color":  "#14161c",
                         "font":  "dash",
                         "align":  "center",
                         "bold":  true,
                         "italic":  true
                     },
                     {
                         "name":  "Round",
                         "type":  "text",
                         "x":  8,
                         "y":  86,
                         "w":  90,
                         "size":  15,
                         "text":  "{rc.qual.header}",
                         "color":  "#3a2a00",
                         "font":  "Saira Condensed",
                         "align":  "center",
                         "upper":  true
                     },
                     {
                         "name":  "Car name",
                         "type":  "text",
                         "x":  128,
                         "y":  8,
                         "w":  200,
                         "size":  34,
                         "text":  "{rc.qual.car_name}",
                         "color":  "@white",
                         "font":  "dash",
                         "upper":  true,
                         "bold":  true,
                         "italic":  true
                     },
                     {
                         "name":  "Car number",
                         "type":  "text",
                         "x":  128,
                         "y":  44,
                         "w":  90,
                         "size":  18,
                         "text":  "#{rc.qual.car_num}",
                         "color":  "@gold",
                         "font":  "dash",
                         "bold":  true,
                         "italic":  true
                     },
                     {
                         "name":  "Delta (faster)",
                         "type":  "text",
                         "x":  300,
                         "y":  4,
                         "w":  148,
                         "size":  44,
                         "text":  "{rc.qual.right}",
                         "color":  "#5ac828",
                         "font":  "dash",
                         "align":  "right",
                         "bold":  true,
                         "italic":  true,
                         "show":  "rc.qual.faster"
                     },
                     {
                         "name":  "Delta (slower)",
                         "type":  "text",
                         "x":  300,
                         "y":  4,
                         "w":  148,
                         "size":  44,
                         "text":  "{rc.qual.right}",
                         "color":  "#eb4a3c",
                         "font":  "dash",
                         "align":  "right",
                         "bold":  true,
                         "italic":  true,
                         "show":  "!rc.qual.faster"
                     },
                     {
                         "name":  "Divider",
                         "type":  "rect",
                         "x":  128,
                         "y":  74,
                         "w":  320,
                         "h":  1,
                         "fill":  "#ffffff22"
                     },
                     {
                         "name":  "Pole label",
                         "type":  "text",
                         "x":  128,
                         "y":  84,
                         "w":  50,
                         "size":  13,
                         "text":  "POLE",
                         "color":  "@grey",
                         "font":  "Saira Condensed"
                     },
                     {
                         "name":  "Pole",
                         "type":  "text",
                         "x":  170,
                         "y":  80,
                         "w":  180,
                         "size":  20,
                         "text":  "#{rc.qual.pole_num}  {rc.qual.pole_name}",
                         "color":  "@white",
                         "font":  "dash",
                         "upper":  true,
                         "bold":  true,
                         "italic":  true
                     },
                     {
                         "name":  "Pole time",
                         "type":  "text",
                         "x":  340,
                         "y":  78,
                         "w":  108,
                         "size":  22,
                         "text":  "{rc.qual.pole_time}",
                         "color":  "@gold",
                         "font":  "dash",
                         "align":  "right",
                         "bold":  true,
                         "italic":  true
                     }
                 ]
}
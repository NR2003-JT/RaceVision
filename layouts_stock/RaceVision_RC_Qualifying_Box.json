{
    "title":  "RaceVision RC Qualifying Box (RaceControl feed: pole, car on track, delta)",
    "panel":  "custom",
    "w":  440,
    "h":  132,
    "when":  "rc.qual",
    "accent":  "car",
    "elements":  [
                     {
                         "name":  "Panel",
